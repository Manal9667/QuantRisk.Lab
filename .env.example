# ---------------------------------------------------------------------------
# QuantumRiskLab configuration. Copy to `.env` and adjust as needed.
# All settings are read via pydantic-settings (see src/quantumrisklab/config.py).
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# When running via docker compose, host is the service name `postgres`.
QRL_DB_HOST=localhost
QRL_DB_PORT=5432
QRL_DB_NAME=quantumrisklab
QRL_DB_USER=qrl
QRL_DB_PASSWORD=qrl_password
# Optional: full SQLAlchemy URL. If set, it overrides the discrete fields above.
# Use sqlite for a zero-infrastructure local run:
#   QRL_DATABASE_URL=sqlite:///./quantumrisklab.db
# QRL_DATABASE_URL=

# --- Data pipeline --------------------------------------------------------
# Master random seed for deterministic synthetic data and experiments.
QRL_RANDOM_SEED=42
# Number of synthetic assets to generate (30-100 per the spec).
QRL_N_ASSETS=60
# Number of trading days of history to synthesize.
QRL_N_TRADING_DAYS=756
# Annual risk-free rate used for Sharpe ratio.
QRL_RISK_FREE_RATE=0.02

# --- Optimization defaults ------------------------------------------------
# Risk-aversion lambda in `expected_return - lambda*risk - tx_cost`.
QRL_RISK_AVERSION=5.0
# Proportional transaction cost (e.g. 0.001 = 10 bps).
QRL_TRANSACTION_COST=0.001

# --- Quantum backend ------------------------------------------------------
# One of: exact | qaoa | numpy_min_eigen
QRL_QUANTUM_BACKEND=exact
# QAOA repetitions (circuit depth p).
QRL_QAOA_REPS=1
# Sampler shots for QAOA sampling.
QRL_QAOA_SHOTS=1024

# --- API ------------------------------------------------------------------
QRL_API_HOST=0.0.0.0
QRL_API_PORT=8000
QRL_LOG_LEVEL=INFO
